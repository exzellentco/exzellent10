# Template listing every setting this website needs.
# Copy to .env and fill in the real values. Never put real values in THIS file -
# .env.example is saved into version control, .env is not.

# Backend API server, e.g. https://api.exzellent.co (no trailing slash).
# Without this, every page that loads data fails with "Failed to fetch ...".
VITE_BACKEND_BASE_URL=

# Google sign-in client ID (Login / Signup)
VITE_GOOGLE_CLIENT_ID=

# Stripe PUBLISHABLE key, starts with pk_ (Payment pages)
VITE_STRIPE_PUBLISHABLE_KEY=

# Cloudinary image uploads
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
